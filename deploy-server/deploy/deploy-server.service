[Unit]
Description=Deploy Server (lightweight imperative CI/CD platform)
Documentation=https://gitee.com/ppnt/deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/deploy

# Listening on 0.0.0.0 is intentional: CLI clients and browsers on the LAN need
# direct access. If this machine has a public entry point, change it to 127.0.0.1
# and put nginx in front of it with HTTPS -
# this service is remote command execution by nature; running it naked on the
# public internet is the same as handing the server over.
#
# There is deliberately no -server-url here. The external address injected into
# scripts as DEPLOY_SERVER_URL is a runtime setting, editable in the web UI
# (system settings), so a changed public address needs no unit edit and no
# restart. Passing -server-url would only seed the initial default.
ExecStart=/usr/local/bin/deploy-server \
    -listen 0.0.0.0:10055 \
    -data-dir /srv/deploy/data \
    -web-root /srv/deploy/workspaces

Restart=on-failure
RestartSec=3

# This is a "remote command execution" service and in principle should not be
# constrained by a sandbox (running arbitrary scripts is the whole point), so the
# hardening below only reduces accidental damage, it does not provide real isolation.
NoNewPrivileges=true
LimitNOFILE=65535

# Graceful shutdown: leave in-flight deployments time to finish.
KillSignal=SIGTERM
TimeoutStopSec=90

StandardOutput=journal
StandardError=journal
SyslogIdentifier=deploy-server

[Install]
WantedBy=multi-user.target
